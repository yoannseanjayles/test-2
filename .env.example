# ─────────────────────────────────────────────────────────────────────────
# chien et chat — variables d'environnement (audit 2026-08, EL-4)
#
# Copier en `.env.local` pour le développement. Sur Vercel, poser chaque
# variable avec des VALEURS DISTINCTES entre les scopes Production et
# Preview : ni base, ni secret, ni clé de paiement partagés (Check 5).
# ─────────────────────────────────────────────────────────────────────────

# ── Obligatoires en production ───────────────────────────────────────────

# Postgres Neon. Absente en développement → PGlite en mémoire.
# En production son absence fait désormais échouer le démarrage (EL-4) :
# la base en mémoire est effacée à chaque démarrage à froid.
# Brancher une branche Neon DIFFÉRENTE sur Preview et sur Production.
DATABASE_URL=

# Signature des sessions Better Auth. Sans elle, la production refuse de
# démarrer (CR-1) : le secret de repli est en clair dans le dépôt et rend
# toute session forgeable, rôle Admin compris.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL canonique de l'application. Sans elle, l'URL est déduite de la requête.
BETTER_AUTH_URL=https://exemple.fr
NEXT_PUBLIC_SITE_URL=https://exemple.fr

# ── Paiement ─────────────────────────────────────────────────────────────
# Sans STRIPE_SECRET_KEY, les commandes passent en mode démonstration
# (statut « Payée (démonstration) », aucun encaissement).
# En production : clés `sk_live_` / `pk_live_` uniquement.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret de signature de l'endpoint webhook — propre à CHAQUE URL déclarée
# dans Stripe. Celui du tableau de bord de test ne vaut pas en production.
# Endpoint à déclarer : https://<domaine>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── E-mails transactionnels (Resend) ─────────────────────────────────────
# Sans RESEND_API_KEY : pas de vérification d'e-mail, pas de confirmation de
# commande, pas d'alerte retour en stock, formulaire de contact inopérant.
RESEND_API_KEY=
EMAIL_FROM=chien et chat <bonjour@exemple.fr>
CONTACT_EMAIL=contact@exemple.fr

# ── Optionnels ───────────────────────────────────────────────────────────

# Connexion Google. Les deux variables ou aucune.
# URI de redirection : <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Amorçage du premier compte administrateur en production (CR-2).
# Laisser VIDE par défaut : sans cette variable, le bouton « Devenir
# administrateur » est refusé et le rôle s'attribue en base —
#   UPDATE "user" SET role = 'Admin' WHERE email = '…';
# Si elle est posée, seule cette adresse, une fois vérifiée, peut s'amorcer.
ADMIN_BOOTSTRAP_EMAIL=
